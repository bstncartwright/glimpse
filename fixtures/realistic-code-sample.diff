diff --git a/db/migrations/20260426_add_order_idempotency.sql b/db/migrations/20260426_add_order_idempotency.sql
new file mode 100644
index 0000000..91df24c
--- /dev/null
+++ b/db/migrations/20260426_add_order_idempotency.sql
@@ -0,0 +1,25 @@
+alter table orders
+  add column idempotency_key text,
+  add column updated_at timestamptz not null default now();
+
+create unique index orders_customer_id_idempotency_key_idx
+  on orders (customer_id, idempotency_key)
+  where idempotency_key is not null;
+
+create or replace function touch_order_updated_at()
+returns trigger as $$
+begin
+  new.updated_at = now();
+  return new;
+end;
+$$ language plpgsql;
+
+create trigger orders_touch_updated_at
+before update on orders
+for each row
+execute function touch_order_updated_at();
+
+update orders
+set updated_at = coalesce(paid_at, created_at)
+where updated_at is null;
+
