+import type { KeyEvent } from "@opentui/core"
+import type { AppState } from "./types"
+import { moveFile, setScrollY, toggleHelp } from "./state"
+
+export function reduceKey(state: AppState, key: KeyEvent): AppState | "quit" {
+  if (key.name === "q" || key.name === "escape") {
+    return "quit"
+  }
+
+  if (key.name === "?") {
+    return toggleHelp(state)
+  }
+
+  if (state.mode === "help") {
+    return toggleHelp(state)
+  }
+
+  if (key.name === "l" || key.name === "]" || key.name === "tab") {
+    return moveFile(state, 1)
+  }
+
+  if (key.name === "h" || key.name === "[") {
+    return moveFile(state, -1)
+  }
+
+  if (key.name === "j" || key.name === "down") {
+    return setScrollY(state, currentScroll(state) + 1)
+  }
+
+  if (key.name === "k" || key.name === "up") {
+    return setScrollY(state, currentScroll(state) - 1)
+  }
+
+  if (key.ctrl && key.name === "d") {
+    return setScrollY(state, currentScroll(state) + 12)
+  }
+
+  if (key.ctrl && key.name === "u") {
+    return setScrollY(state, currentScroll(state) - 12)
+  }
+
+  return state
+}
+
+function currentScroll(state: AppState): number {
+  const file = state.diffSet.files[state.activeFileIndex]
+  if (!file) return 0
+  return state.scrollYByPath[file.displayPath] ?? 0
+}
