+export const theme = {
+  bg: "#0b0f14",
+  panel: "#101821",
+  border: "#26323d",
+  text: "#d6dee6",
+  muted: "#65717d",
+  subtle: "#3c4853",
+  active: "#4fb3d8",
+  activeBg: "#102f3c",
+  add: "#7bd88f",
+  addBg: "#102819",
+  del: "#f7768e",
+  delBg: "#30151b",
+  warn: "#e6c678",
+  command: "#88c0d0",
+}
+
+export type Theme = typeof theme
+
+export function getStatusColor(status: string): string {
+  switch (status) {
+    case "added":
+      return theme.add
+    case "deleted":
+      return theme.del
+    case "renamed":
+      return theme.warn
+    case "binary":
+      return theme.command
+    default:
+      return theme.text
+  }
+}
