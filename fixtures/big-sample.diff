+export type Config = {
+  contextLines: number
+  wrap: boolean
+  showWhitespace: boolean
+  keybindings: Record<string, string[]>
+}
+
+export const defaultConfig: Config = {
+  contextLines: 3,
+  wrap: false,
+  showWhitespace: false,
+  keybindings: {
+    nextFile: ["l", "]", "tab"],
+    previousFile: ["h", "["],
+    scrollDown: ["j", "down"],
+    scrollUp: ["k", "up"],
+  },
+}
+
+export async function loadConfig(cwd = process.cwd()): Promise<Config> {
+  const user = await readJson(`${process.env.HOME}/.config/glimpse/config.json`)
+  const local = await readJson(`${cwd}/.glimpserc.json`)
+  return mergeConfig(defaultConfig, user, local)
+}
+
+function mergeConfig(...configs: Array<Partial<Config> | null>): Config {
+  return configs.reduce<Config>(
+    (merged, config) => ({
+      ...merged,
+      ...(config ?? {}),
+      keybindings: {
+        ...merged.keybindings,
+        ...(config?.keybindings ?? {}),
+      },
+    }),
+    defaultConfig,
+  )
+}
+
+async function readJson(path: string): Promise<Partial<Config> | null> {
+  try {
+    return await Bun.file(path).json()
+  } catch {
+    return null
+  }
+}
