{
  "name": "@bstncartwright/glimpse",
  "version": "0.1.4",
  "description": "full-screen terminal diff review for bun-powered terminals",
  "module": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "author": "Boston Cartwright <bostonc@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bstncartwright/glimpse"
  },
  "keywords": [
    "bun",
    "cli",
    "diff",
    "git",
    "terminal",
    "tui"
  ],
  "bin": {
    "glimpse": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "generate:huge-sample": "bun run scripts/generate-large-fixture.ts",
    "generate:large-varied-sample": "bun run scripts/generate-varied-fixture.ts",
    "prepack": "bun run typecheck && bun test",
    "test": "bun test",
    "test:e2e": "bunx --bun @microsoft/tui-test",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck"
  },
  "devDependencies": {
    "@microsoft/tui-test": "^0.0.4",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@derekstride/tree-sitter-sql": "^0.3.11",
    "@lumis-sh/wasm-c": "^0.26.0",
    "@lumis-sh/wasm-html": "^0.26.1",
    "@lumis-sh/wasm-json": "^0.26.2",
    "@lumis-sh/wasm-sql": "^0.26.1",
    "@lumis-sh/wasm-toml": "^0.26.0",
    "@lumis-sh/wasm-yaml": "^0.26.0",
    "@opentui/core": "^0.1.103",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "diff": "8.0.2",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-toml": "^0.5.1",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.25.10"
  }
}
